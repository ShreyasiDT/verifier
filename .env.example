# Copy this file to .env.local and fill in the values.
# Never prefix these with NEXT_PUBLIC_ — that would expose them to the browser.

# LLM — OpenAI-compatible proxy
CHATGPT_PROXY_API_KEY=
CHATGPT_PROXY_BASE_URL=
LLM_MODEL=gpt-6-luna

# Web search — https://exa.ai
EXA_API_KEY=

# Published fact-checks — Google Fact Check Tools API (free; restrict the key to that API)
GOOGLE_FACT_CHECK_API_KEY=

# Shared cache + rate limiting — Upstash Redis (optional locally; required in production).
# On Vercel, adding the Upstash integration fills these in automatically (as KV_REST_API_URL /
# KV_REST_API_TOKEN, which also work). Leave empty locally to run without limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
